#!/bin/bash
# Runs mini-meeting-minutes, building it first if the sources are newer than the binary.
# Usage: ./mmm [command] [options]   (see ./mmm --help)
set -euo pipefail

# Resolve symlinks, so the script also works when linked onto the PATH.
source="${BASH_SOURCE[0]}"
while [[ -L "$source" ]]; do
  directory="$(cd -P "$(dirname "$source")" && pwd)"
  source="$(readlink "$source")"
  [[ "$source" == /* ]] || source="$directory/$source"
done
root="$(cd -P "$(dirname "$source")" && pwd)"
sources=("$root/Sources" "$root/Package.swift" "$root/Package.resolved")

# The installer usually downloads mmm prebuilt. It's used until the sources here change.
prebuilt="$root/.build/prebuilt/mmm"
if [[ -x "$prebuilt" && -z "$(find "${sources[@]}" -newer "$prebuilt" -print -quit 2>/dev/null)" ]]; then
  # Built elsewhere, it can't find the models beside its own sources, so it's told where they are.
  export MMM_MODELS_DIR="${MMM_MODELS_DIR:-$root/Models}"
  exec "$prebuilt" "$@"
fi

# --disable-keychain: SwiftPM otherwise looks up GitHub credentials in the keychain, which can
# block on an access prompt while resolving dependencies.
build=(swift build --package-path "$root" -c release --disable-keychain)
# An update that only partly installed can leave the command line tools' `swift build` crashing as
# it starts. Xcode's Swift works then, without changing which developer tools are selected.
if ! bin_dir="$(xcode-select -p >/dev/null 2>&1 && "${build[@]}" --show-bin-path 2>/dev/null)"; then
  for xcode in /Applications/Xcode*.app/Contents/Developer; do
    if [[ -d "$xcode" ]] && bin_dir="$(DEVELOPER_DIR="$xcode" "${build[@]}" --show-bin-path 2>/dev/null)"; then
      export DEVELOPER_DIR="$xcode"
      break
    fi
    bin_dir=""
  done
  if [[ -z "$bin_dir" ]]; then
    echo "mmm needs building, which needs Apple's developer tools, and none that work were found." >&2
    echo "Run the installer again to download it prebuilt." >&2
    exit 1
  fi
fi
bin="$bin_dir/mmm"

if [[ ! -x "$bin" ]] || [[ -n "$(find "${sources[@]}" -newer "$bin" -print -quit 2>/dev/null)" ]]; then
  echo "Building mini-meeting-minutes (first run takes a few minutes)…" >&2
  "${build[@]}" >&2
fi
exec "$bin" "$@"
